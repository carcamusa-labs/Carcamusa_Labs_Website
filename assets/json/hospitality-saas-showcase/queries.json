    {
      "id": "nrr",
      "buttonLabel": "NRR",
      "title": "Net Revenue Retention (NRR)",
      "description": "Measures how much existing revenue is retained after expansion and churn. Values above 100% mean expansion outweighs lost MRR — a strong SaaS health signal.",
      "sql": "SELECT\n        month,\n        SUM(mrr) AS base_mrr,\n        SUM(ISNULL(expansion_mrr, 0)) AS expansion_mrr,\n        SUM(CASE WHEN churn_flag = 1 THEN mrr ELSE 0 END) AS churned_mrr\n    FROM subscriptions\n    GROUP BY month\n)\nSELECT\n    month,\n    CASE\n        WHEN base_mrr = 0 THEN NULL\n        ELSE CAST(\n            ROUND(\n                (base_mrr + expansion_mrr - churned_mrr) * 100.0 / base_mrr,\n                2\n            )\n            AS DECIMAL(10, 2)\n        )\n    END AS nrr_percentage\nFROM base\nORDER BY month;",
