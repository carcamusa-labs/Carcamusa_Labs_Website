    {
      "id": "arr",
      "buttonLabel": "ARR",
      "title": "Annual Recurring Revenue (ARR)",
      "description": "Annualizes each month's MRR (× 12) to express run-rate revenue. Helpful when comparing SaaS performance to annual targets or investor benchmarks.",
      "sql": "SELECT\n        month,\n        SUM(mrr + ISNULL(expansion_mrr, 0)) AS total_mrr\n    FROM subscriptions\n    GROUP BY month\n)\nSELECT\n    month,\n    CAST(ROUND(total_mrr, 2) AS DECIMAL(18, 2)) AS total_mrr,\n    CAST(ROUND(total_mrr * 12, 2) AS DECIMAL(18, 2)) AS arr\nFROM mrr\nORDER BY month;",
