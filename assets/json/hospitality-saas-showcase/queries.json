    {
      "id": "arpa",
      "buttonLabel": "ARPA",
      "title": "Average Revenue Per Account (ARPA)",
      "description": "Total monthly recurring revenue divided by active hotels. Tracks whether monetization per customer is improving, independent of customer count.",
      "sql": "SELECT\n        month,\n        SUM(mrr + ISNULL(expansion_mrr, 0)) AS total_revenue\n    FROM subscriptions\n    GROUP BY month\n),\ncustomers AS (\n    SELECT\n        month,\n        COUNT(DISTINCT hotel_id) AS total_customers\n    FROM subscriptions\n    GROUP BY month\n)\nSELECT\n    r.month,\n    CASE\n        WHEN c.total_customers = 0 THEN NULL\n        ELSE CAST(\n            ROUND(r.total_revenue * 1.0 / c.total_customers, 2)\n            AS DECIMAL(18, 2)\n        )\n    END AS arpa\nFROM revenue AS r\nINNER JOIN customers AS c\n    ON r.month = c.month\nORDER BY r.month;",
